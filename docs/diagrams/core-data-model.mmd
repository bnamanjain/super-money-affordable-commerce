erDiagram
  USER ||--o{ CREDIT_PROFILE : has
  USER ||--o{ CONSENT_RECORD : grants
  USER ||--o{ AFFORDABILITY_QUOTE : requests
  SELLER ||--o{ PRODUCT : owns
  SELLER ||--o{ OFFER : funds
  PRODUCT ||--o{ PRODUCT_FINANCE_RULE : constrained_by
  PRODUCT ||--o{ AFFORDABILITY_QUOTE : priced_for
  OFFER ||--o{ AFFORDABILITY_QUOTE : contributes_to
  AFFORDABILITY_QUOTE ||--o| CHECKOUT_SESSION : selected_in
  CHECKOUT_SESSION ||--o{ CHECKOUT_STEP : records
  CHECKOUT_SESSION ||--o| LOAN_MIRROR : links
  CHECKOUT_SESSION ||--o| PAYMENT_ATTEMPT : collects
  CHECKOUT_SESSION ||--o| ORDER : creates
  LOAN_MIRROR ||--o{ REPAYMENT_INSTALLMENT : projects
  ORDER ||--o{ REFUND : may_have
  ORDER ||--o{ SETTLEMENT_ENTRY : posts
  REFUND ||--o{ SETTLEMENT_ENTRY : reverses

  USER {
    uuid user_id PK
    string kyc_status
    string risk_segment
  }
  CREDIT_PROFILE {
    uuid credit_profile_id PK
    uuid user_id FK
    string lender_id
    bigint available_limit_paise
    string status
  }
  CONSENT_RECORD {
    uuid consent_id PK
    uuid user_id FK
    string purpose
    string document_hash
    timestamp accepted_at
  }
  SELLER {
    uuid seller_id PK
    string kyb_status
    string risk_tier
  }
  PRODUCT {
    uuid product_id PK
    uuid seller_id FK
    string external_sku_id
    bigint price_paise
    string status
  }
  PRODUCT_FINANCE_RULE {
    uuid rule_id PK
    uuid product_id FK
    string lender_id
    json allowed_tenors
  }
  OFFER {
    uuid offer_id PK
    uuid seller_id FK
    int subvention_bps
    bigint budget_paise
  }
  AFFORDABILITY_QUOTE {
    uuid quote_id PK
    uuid user_id FK
    uuid product_id FK
    string lender_id
    bigint total_payable_paise
    timestamp expires_at
  }
  CHECKOUT_SESSION {
    uuid checkout_session_id PK
    uuid quote_id FK
    string status
    int version
  }
  CHECKOUT_STEP {
    uuid step_id PK
    uuid checkout_session_id FK
    string step_type
    string status
  }
  LOAN_MIRROR {
    uuid loan_mirror_id PK
    string lender_loan_id
    string status
  }
  PAYMENT_ATTEMPT {
    uuid payment_attempt_id PK
    string rail
    bigint amount_paise
    string status
  }
  ORDER {
    uuid order_id PK
    string external_order_id
    string status
  }
  REPAYMENT_INSTALLMENT {
    uuid installment_id PK
    date due_date
    bigint amount_due_paise
    string status
  }
  REFUND {
    uuid refund_id PK
    bigint amount_paise
    string status
  }
  SETTLEMENT_ENTRY {
    uuid entry_id PK
    bigint amount_paise
    string entry_type
  }
